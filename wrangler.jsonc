{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "game-curation",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "game-curation",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "game-curation-media",
		},
	],
	"routes": [{ "pattern": "game-curation.napoblog.com", "custom_domain": true }],
	"triggers": {
		"crons": ["* * * * *"],
	},
}
