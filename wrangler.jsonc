{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "game-curation",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "game-curation",
			"database_id": "1152a052-2917-4abf-bcac-ab6936eaf52f",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "9da0e2862f424cfd8a3aff1cceb45883",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "game-curation-media",
		},
	],
	"routes": [{ "pattern": "game-curation.napoblog.com", "custom_domain": true }],
	"triggers": {
		"crons": ["* * * * *"],
	},
}
