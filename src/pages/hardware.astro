---
import Base from "../layouts/Base.astro";
import { PLATFORMS, gamesUrl, loadGames } from "../lib/games";
import { hardwareInfo } from "../lib/amazon";

const { games, cacheHint } = await loadGames();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const OTHER = ["arcade", "pc", "mobile", "vr"];

const items = Object.entries(PLATFORMS)
	.map(([slug, label]) => {
		const info = hardwareInfo(slug);
		const list = games.filter((g) => g.platforms.some((p) => p.slug === slug));
		const picks = list.filter((g) => g.tier === "essential").slice(0, 4);
		return info ? { slug, label, info, count: list.length, picks } : null;
	})
	.filter((x): x is NonNullable<typeof x> => !!x);

const consoles = items
	.filter((x) => !OTHER.includes(x.slug))
	.sort((a, b) => (a.info.year ?? 0) - (b.info.year ?? 0));
const others = items.filter((x) => OTHER.includes(x.slug));

// 年代ごとに見出しを付ける(本体の発売年で区切る)
const groups = [
	{ label: "〜1980年代", from: 0, to: 1989 },
	{ label: "1990年代", from: 1990, to: 1999 },
	{ label: "2000年代", from: 2000, to: 2009 },
	{ label: "2010年代", from: 2010, to: 2019 },
	{ label: "2020年代(現行機)", from: 2020, to: 2100 },
].map((g) => ({ ...g, items: consoles.filter((c) => (c.info.year ?? 0) >= g.from && (c.info.year ?? 0) <= g.to) }));
---

<Base title="機種ガイド" description="ファミコンからNintendo Switch 2まで、掲載作品が遊べるゲーム機の特徴と代表作をまとめた機種ガイド。">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Hardware</p>
			<h1 class="intro__title">機種ガイド</h1>
			<p class="intro__lead">
				このサイトに載っている作品が遊べるゲーム機を、発売年の順にまとめました。どんな機種だったのか、代表作は何かが一目で分かります。生産が終わった機種は、中古品や復刻版の「ミニ」本体で遊べるものもあります。
			</p>
		</div>
	</header>

	<nav class="band hw-nav" aria-label="年代へ移動">
		<div class="frame">
			<ul>
				{groups.map((g, i) => g.items.length > 0 && <li><a href={`#hw-${i}`}>{g.label}</a></li>)}
				<li><a href="#hw-other">PC・その他</a></li>
			</ul>
		</div>
	</nav>

	{
		[...groups.map((g, i) => ({ id: `hw-${i}`, label: g.label, items: g.items })), { id: "hw-other", label: "PC・その他", items: others }]
			.filter((g) => g.items.length > 0)
			.map((group) => (
				<section class="band section" id={group.id} aria-labelledby={`${group.id}-h`}>
					<div class="frame">
						<h2 id={`${group.id}-h`} class="group-title">{group.label}</h2>
						<div class="hw-grid">
							{group.items.map(({ slug, label, info, count, picks }) => (
								<article class="hw" id={slug}>
									<header class="hw__head">
										<h3 class="hw__name">{label}</h3>
										<p class="hw__meta">
											{info.maker}
											{info.year && <span> · {info.year}年</span>}
											<span> · {info.gen}</span>
										</p>
										{info.note && <p class="hw__note">※{info.note}</p>}
									</header>
									<p class="hw__desc">{info.desc}</p>
									{picks.length > 0 && (
										<p class="hw__picks">
											代表作:
											{picks.map((g, i) => (
												<>
													{i > 0 && "、"}
													<a href={`/games/${g.slug}`}>{g.title}</a>
												</>
											))}
										</p>
									)}
									<div class="hw__actions">
										{count > 0 && (
											<a href={gamesUrl({ platform: slug })} class="btn btn--ghost btn--sm">
												掲載作品 {count}本
											</a>
										)}
										{info.amazon && (
											<a href={info.amazon.url} class="hw__amazon" rel="sponsored noopener" target="_blank">
												<span class="pr">PR</span>
												{info.amazon.label} ↗
											</a>
										)}
									</div>
								</article>
							))}
						</div>
					</div>
				</section>
			))
	}
</Base>

<style>
	.hw-nav {
		position: sticky;
		top: var(--header-height, var(--nav-height));
		z-index: 5;
		background: color-mix(in oklab, var(--color-bg) 88%, transparent);
		backdrop-filter: blur(8px);
	}

	.hw-nav ul {
		list-style: none;
		display: flex;
		gap: var(--spacing-1);
		padding-block: var(--spacing-3);
		overflow-x: auto;
		scrollbar-width: none;
	}

	.hw-nav a {
		display: inline-block;
		padding: var(--spacing-1) var(--spacing-3);
		border-radius: var(--radius-full);
		font-size: var(--font-size-sm);
		white-space: nowrap;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.hw-nav a:hover {
		background: var(--color-surface);
		color: var(--color-text);
	}

	section[id] {
		scroll-margin-top: calc(var(--header-height, var(--nav-height)) + 56px);
	}

	.group-title {
		margin-bottom: var(--spacing-5);
		font-size: var(--font-size-2xl);
	}

	.hw-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
		gap: var(--spacing-4);
	}

	.hw {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		padding: var(--spacing-5);
		background: var(--color-surface);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-card);
		scroll-margin-top: calc(var(--header-height, var(--nav-height)) + 64px);
	}

	.hw__name {
		font-size: var(--font-size-xl);
	}

	.hw__meta {
		margin-top: var(--spacing-1);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.hw__note {
		margin-top: var(--spacing-1);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.hw__desc {
		font-size: var(--font-size-sm);
		line-height: 1.8;
		color: var(--color-text-secondary);
	}

	.hw__picks {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.hw__picks a {
		color: var(--color-text);
	}

	.hw__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-2);
		margin-top: auto;
	}

	.hw__amazon {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		min-height: 2rem;
		padding: var(--spacing-1) var(--spacing-3);
		border-radius: var(--radius-full);
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-decoration: none;
	}

	.hw__amazon:hover {
		background: var(--color-brand-hover);
	}

	.pr {
		padding: 0 0.3rem;
		border-radius: 3px;
		background: color-mix(in oklab, var(--color-on-brand) 22%, transparent);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.05em;
	}
</style>
