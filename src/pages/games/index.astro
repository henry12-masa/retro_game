---
import Base from "../../layouts/Base.astro";
import GameCard from "../../components/GameCard.astro";
import {
	ERAS,
	GENRES,
	PLATFORMS,
	TIERS,
	eraBySlug,
	gamesUrl,
	loadGames,
	sortGames,
	type SortKey,
} from "../../lib/games";

const { games, cacheHint } = await loadGames();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const q = Astro.url.searchParams;
const filters = {
	era: q.get("era") ?? "",
	genre: q.get("genre") ?? "",
	platform: q.get("platform") ?? "",
	tier: q.get("tier") ?? "",
	sort: (q.get("sort") ?? "old") as SortKey,
};

const filtered = sortGames(
	games.filter(
		(g) =>
			(!filters.era || g.era?.slug === filters.era) &&
			(!filters.genre || g.genres.some((x) => x.slug === filters.genre)) &&
			(!filters.platform || g.platforms.some((x) => x.slug === filters.platform)) &&
			(!filters.tier || g.tier === filters.tier),
	),
	filters.sort,
);

// 年代順のときは年代ごとに見出しで区切る
const grouped =
	filters.sort === "old" || filters.sort === "new"
		? (filters.sort === "new" ? [...ERAS].reverse() : ERAS)
				.map((era) => ({ era, games: filtered.filter((g) => g.era?.slug === era.slug) }))
				.filter((group) => group.games.length > 0)
		: null;

// 選択中の条件の説明(見出し用)
const era = eraBySlug(filters.era);
const active = [
	era && { key: "era", label: era.label },
	filters.genre && { key: "genre", label: GENRES[filters.genre as keyof typeof GENRES] },
	filters.platform && { key: "platform", label: PLATFORMS[filters.platform as keyof typeof PLATFORMS] },
	filters.tier && { key: "tier", label: TIERS[filters.tier as keyof typeof TIERS] },
].filter(Boolean) as Array<{ key: keyof typeof filters; label: string }>;

const heading = active.length ? active.map((a) => a.label).join(" × ") : "すべてのゲーム";

// 現在の絞り込みに対して、ほかの条件で何本あるか(0本の選択肢を薄くする)
function countWith(key: "era" | "genre" | "platform" | "tier", value: string) {
	const f = { ...filters, [key]: value };
	return games.filter(
		(g) =>
			(!f.era || g.era?.slug === f.era) &&
			(!f.genre || g.genres.some((x) => x.slug === f.genre)) &&
			(!f.platform || g.platforms.some((x) => x.slug === f.platform)) &&
			(!f.tier || g.tier === f.tier),
	).length;
}

const without = (key: string) =>
	gamesUrl({ ...filters, sort: filters.sort === "old" ? undefined : filters.sort, [key]: undefined });
---

<Base
	title={active.length ? `${heading}のゲーム` : "ゲーム一覧"}
	description={era ? era.lead : "レトロから新作まで、年代・ジャンル・機種で絞り込めるゲーム一覧。"}
>
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Games</p>
			<h1 class="intro__title">{heading}</h1>
			<p class="intro__lead">
				{era ? era.lead : "年代・ジャンル・機種を組み合わせて、次に遊ぶ1本を探してください。"}
			</p>
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<form method="get" action="/games" class="filters" aria-label="絞り込み">
				<label>
					<span>年代</span>
					<select name="era">
						<option value="">すべて</option>
						{ERAS.map((e) => (
							<option value={e.slug} selected={filters.era === e.slug}>
								{e.label}({countWith("era", e.slug)})
							</option>
						))}
					</select>
				</label>
				<label>
					<span>ジャンル</span>
					<select name="genre">
						<option value="">すべて</option>
						{Object.entries(GENRES).map(([slug, label]) => {
							const n = countWith("genre", slug);
							return (
								<option value={slug} selected={filters.genre === slug} disabled={n === 0 && filters.genre !== slug}>
									{label}({n})
								</option>
							);
						})}
					</select>
				</label>
				<label>
					<span>機種</span>
					<select name="platform">
						<option value="">すべて</option>
						{Object.entries(PLATFORMS).map(([slug, label]) => {
							const n = countWith("platform", slug);
							return (
								<option value={slug} selected={filters.platform === slug} disabled={n === 0 && filters.platform !== slug}>
									{label}({n})
								</option>
							);
						})}
					</select>
				</label>
				<label>
					<span>推し度</span>
					<select name="tier">
						<option value="">すべて</option>
						{Object.entries(TIERS).map(([slug, label]) => (
							<option value={slug} selected={filters.tier === slug}>
								{label}({countWith("tier", slug)})
							</option>
						))}
					</select>
				</label>
				<label>
					<span>並び順</span>
					<select name="sort">
						<option value="old" selected={filters.sort === "old"}>古い順</option>
						<option value="new" selected={filters.sort === "new"}>新しい順</option>
						<option value="tier" selected={filters.sort === "tier"}>推し度順</option>
						<option value="title" selected={filters.sort === "title"}>タイトル順</option>
					</select>
				</label>
				<button type="submit" class="btn">絞り込む</button>
			</form>

			<div class="result-bar">
				<p class="result-count"><strong>{filtered.length}</strong> 本</p>
				{
					active.length > 0 && (
						<ul class="chips active-filters">
							{active.map((a) => (
								<li>
									<a href={without(a.key)} class="chip" aria-label={`${a.label}の条件を外す`}>
										{a.label} ×
									</a>
								</li>
							))}
							<li><a href="/games" class="clear">すべて解除</a></li>
						</ul>
					)
				}
			</div>

			{
				filtered.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">該当するゲームがありません</h2>
						<p class="empty-state__text">条件をひとつ外してみてください。</p>
						<div class="empty-state__actions">
							<a href="/games" class="btn">条件をリセット</a>
						</div>
					</div>
				) : grouped ? (
					grouped.map(({ era: groupEra, games: list }) => (
						<section class="era-group" aria-labelledby={`era-${groupEra.slug}`}>
							<h2 id={`era-${groupEra.slug}`} class="era-group__title" data-era={groupEra.slug}>
								<span class="era-group__swatch" aria-hidden="true" />
								{groupEra.label}
								<span class="era-group__count">{list.length}本</span>
							</h2>
							<div class="game-grid">
								{list.map((game) => <GameCard game={game} headingLevel={3} />)}
							</div>
						</section>
					))
				) : (
					<div class="game-grid">
						{filtered.map((game) => <GameCard game={game} headingLevel={2} />)}
					</div>
				)
			}
		</div>
	</section>
</Base>

<script>
	// JSが有効なら、選択を変えた時点で絞り込む(ボタンなしでも使える)
	const form = document.querySelector<HTMLFormElement>(".filters");
	form?.addEventListener("change", () => {
		const data = new FormData(form);
		const params = new URLSearchParams();
		for (const [k, v] of data) if (v && !(k === "sort" && v === "old")) params.set(k, String(v));
		const qs = params.toString();
		location.href = qs ? `/games?${qs}` : "/games";
	});
</script>

<style>
	.filters {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr)) auto;
		align-items: end;
		gap: var(--spacing-3);
		padding: var(--spacing-4);
		background: var(--color-surface);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-card);
	}

	.filters label {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
		min-width: 0;
	}

	.filters label > span {
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-muted);
	}

	.filters select {
		width: 100%;
		min-height: 2.5rem;
		padding: 0 var(--spacing-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		font-size: var(--font-size-sm);
	}

	.filters select:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 1px;
	}

	.result-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-3);
		margin-block: var(--spacing-6);
	}

	.result-count {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.result-count strong {
		font-family: var(--font-mono);
		font-size: var(--font-size-xl);
		color: var(--color-text);
	}

	.active-filters {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-2);
	}

	.clear {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.era-group + .era-group {
		margin-top: var(--spacing-12);
	}

	.era-group__title {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-5);
		font-size: var(--font-size-xl);
	}

	.era-group__swatch {
		width: 14px;
		height: 14px;
		border-radius: 4px;
		background: var(--era-bg);
		box-shadow: inset 0 0 0 3px var(--era-ink);
	}

	.era-group__count {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 400;
		color: var(--color-muted);
	}

	@media (max-width: 960px) {
		.filters {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.filters {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
